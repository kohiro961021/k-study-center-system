# ==============================================================================
# K-Study Center 環境變數範本 (.env.example)
# 複製此檔案為 .env (前端根目錄) 或 backend/.env (後端目錄) 並依環境填寫
# ==============================================================================

# 前端設定 (Vite)
VITE_GOOGLE_CLIENT_ID=

# 後端資料庫與快取連線
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/kstudy
REDIS_URL=redis://localhost:6379/0

# JWT 與安全金鑰 (生產環境請用 openssl rand -hex 32 產生)
SECRET_KEY=
QR_SECRET_KEY=

# Google OAuth (後端驗證)
GOOGLE_CLIENT_ID=

# Mail Server (SMTP) 設定
ENABLE_EMAIL=false
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_FROM_EMAIL=noreply@kstudy.local
SMTP_FROM_NAME="K-Study K書中心"

# 彩蛋 CTF 設定 (敏感資訊留空，不應 commit 至 GitHub)
EASTER_EGG_FLAG=
EASTER_EGG_FORM_URL=
EASTER_EGG_CONTACT_EMAIL=
